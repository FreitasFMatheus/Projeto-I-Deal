{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Python: Flask (flask run)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host=127.0.0.1",
                "--port=5000",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "envFile": "${workspaceFolder}\\.env"
        }
    ]
}
