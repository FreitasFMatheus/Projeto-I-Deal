# =============================================================================
# .env.example — Modelo de variáveis de ambiente do projeto I-Deal
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
# =============================================================================

# Chave da API IsThereAnyDeal (usada pelo price_fetcher para preços reais)
# Obtenha em: https://isthereanydeal.com/apps/
# Se ficar vazio, o app roda usando apenas Steam (sem GOG/Epic/Nuuvem/Humble).
ITAD_API_KEY=

# URI de conexão com o MongoDB (necessário para /api/prices/mongo)
MONGODB_URI=mongodb://localhost:27017/

# Nome do banco MongoDB
MONGODB_DB=ideal_db

# Chave secreta do Flask (em produção, troque por algo aleatório!)
FLASK_SECRET_KEY=uma_chave_super_secreta_e_segura_ideal2026

# Modo do Flask (development | production)
FLASK_ENV=development
FLASK_DEBUG=1

# Intervalo do scheduler de atualização de preços em minutos (tarefa 5.5)
PRICE_REFRESH_MINUTES=15

# Taxa fixa de conversão USD -> BRL para lojas que listam em dólar
# (Humble Store, Fanatical). Em produção real, deveria ser cotação ao vivo.
USD_TO_BRL_RATE=5.50

# =============================================================================
# SMTP — Notificações por email (US03 — Alerta de Preço)
# =============================================================================
# Use Gmail com App Password: https://myaccount.google.com/apppasswords
# Requer 2FA ativo na conta Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu.email@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM_NAME=I-Deal Notificacoes
